<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="payment_method_fedapay" model="payment.method">
        <field name="name">FedaPay</field>
        <field name="code">fedapay</field>
        <field name="sequence">1000</field>
        <field name="active">True</field>
        <field name="image" type="base64" file="payment_fedapay/static/description/icon.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">none</field>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.XOF')])]"/>
        <field name="provider_ids" eval="[Command.set([ref('payment_fedapay.payment_provider_fedapay')])]"/>
    </record>
</odoo>