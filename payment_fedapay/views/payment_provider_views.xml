<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">FedaPay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'fedapay'" string="Enter your FedaPay secret key">
                    <field 
                        name="fedapay_live_secret_key" 
                        placeholder="sk_live_xxxxxxxxxxxxxxxxxxxxxxxx"
                        string="Live API Key" 
                        required="code == 'fedapay' and state == 'enabled'"
                        password="True"
                        style="border-bottom: 1px solid #b5b5b5"
                    />
                    <field 
                        name="fedapay_sandbox_secret_key" 
                        placeholder="sk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxx"
                        string="Sandbox API Key" 
                        required="code == 'fedapay' and state == 'test'"
                        password="True"
                        style="border-bottom: 1px solid #b5b5b5"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
